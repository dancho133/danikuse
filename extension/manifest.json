{
  "manifest_version": 3,
  "name": "Danikuse Bridge",
  "version": "0.1.9",
  "description": "Lets the Danikuse CLI work with tabs in your own Brave: list, open, claim. No restart, no debug port.",
  "key": "",
  "permissions": ["tabs", "scripting", "nativeMessaging", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" }
}
